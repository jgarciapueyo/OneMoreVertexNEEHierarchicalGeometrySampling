<?xml version="1.0" encoding="utf-8"?>
<!--
Floating, directly lit quads used for the importance visualization of Fig. 4.
With outputDebugCSV=true the SamplingBVH writes bvh_debug.csv (one row per node,
for the fixed query point debugQueryPoint and the first emitter) when the scene
is loaded:
    mitsuba scenes/0_importance_quads/importance_quads.xml -DoutputDebugCSV=true -Dspp=1
Then visualize it with scripts/polyscope/view_bvh.py bvh_debug.csv and compute the
per-level total variation distance with scripts/figures/fig4_importance_tvd.py.
-->
<scene version="0.6.0">
	<integrator type="oneehgspath_2step">
		<integer name="maxDepth" value="3"/>
		<integer name="rrDepth" value="5"/>
		<boolean name="doAdditionalVertex" value="true"/>
		<boolean name="useBVH" value="true"/>
		<boolean name="disableNEE" value="false"/>
	</integrator>
	<geometrybvh type="samplingbvh">
		<integer name="maxDepth" value="$bvhMaxDepth:10"/>
		<boolean name="specularImportance" value="$specularImportance:false"/>
		<boolean name="outputDebugCSV" value="$outputDebugCSV:false"/>
		<point name="debugQueryPoint" x="2.43008" y="-0.0490401" z="0"/>
		<integer name="debugQueryShape" value="2"/>
	</geometrybvh>
	<sensor type="perspective">
		<string name="fovAxis" value="smaller"/>
		<float name="nearClip" value="0.0001"/>
		<float name="farClip" value="1000"/>
		<transform name="toWorld">
			<lookAt origin="-5, 0, 3" target="0, 0, 1" up="0, 0, 1"/>
		</transform>
		<float name="fov" value="45"/>
		<sampler type="independent">
			<integer name="sampleCount" value="$spp:2048"/>
		</sampler>
		<film type="hdrfilm">
			<integer name="width" value="256"/>
			<integer name="height" value="256"/>
		</film>
	</sensor>
	<emitter type="spot" name="spot_light">
		<transform name="toWorld">
			<rotate x="0" y="1" z="0" angle="60"/>
			<translate x="-5" y="0" z="1"/>
		</transform>
		<rgb name="intensity" value="10000"/>
		<float name="cutoffAngle" value="30"/>
	</emitter>
	<shape type="rectangle">
		<transform name="toWorld">
			<scale x="10" y="10" z="1"/>
			<translate x="0" y="0" z="0"/>
		</transform>
		<bsdf type="diffuse">
			<texture type="checkerboard" name="reflectance">
				<float name="uscale" value="50"/>
				<float name="vscale" value="50"/>
			</texture>
		</bsdf>
	</shape>
	<!-- Add the geometry - floating quads -->
	<include filename="../scene_geometries/quads-geometry.xml"/>
</scene>
