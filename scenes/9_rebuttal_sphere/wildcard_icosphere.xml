<?xml version="1.0" encoding="utf-8"?>
<!--
Parameters written as $name:default can be overridden on the command line,
e.g. mitsuba scenes/9_rebuttal_sphere/wildcard_icosphere.xml -Dspp=64
The experiment configs in scripts/experiments/ set them in the same way.
-->
<scene version="0.6.0">
	<integrator type="$integrator:oneehgspath_2step">
		<integer name="maxDepth" value="$maxDepth:3"/>
		<integer name="rrDepth" value="$rrDepth:5"/>
		<boolean name="useBVH" value="$useBVH:true"/>
		<boolean name="disableNEE" value="$disableNEE:false"/>
	</integrator>
	<geometrybvh type="samplingbvh">
		<integer name="maxDepth" value="$bvhMaxDepth:12"/>
		<string name="samplingMode" value="$leafSamplingMode:Primitive"/>
		<boolean name="outputDebugCSV" value="$outputDebugCSV:false"/>
		<boolean name="enableLightcuts" value="$enableLightcuts:false"/>
		<float name="lightcutThreshold" value="$lightcutThreshold:0"/>
		<float name="gaussianSAThreshold" value="$gaussianSAThreshold:0.2"/>
		<boolean name="uniformImportance" value="$uniformImportance:false"/>
		<boolean name="specularImportance" value="$specularImportance:false"/>
		<string name="sigmaPoints" value="$sigmaPoints:precomputed"/>
		<float name="defensivePDF" value="$defensivePDF:0.000001"/>
	</geometrybvh>
	
	
    <!-- Camera.-->
    <sensor type="perspective">
        <float name="fov" value="40"/>
        <transform name="toWorld">
            <lookAt origin="0, -35, 5" target="0, 0, 4" up="0, 0, 1"/>
        </transform>
        <sampler type="independent">
            <integer name="sampleCount" value="$spp:4"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width" value="800"/>
            <integer name="height" value="600"/>
        </film>
    </sensor> 

    <!-- Spotlight at center, slightly above floor, pointing up, near-180° cone -->
    <!-- <emitter type="spot">
        <transform name="toWorld">
            <lookAt origin="0, 0, 0.1" target="0, 0, 1" up="0, 1, 0"/>
        </transform>
        <float name="cutoffAngle" value="10.0"/>
        <float name="beamWidth" value="10.0"/>
        <rgb name="intensity" value="100.0, 90.0, 40.0"/>
    </emitter> -->
	
    <!-- <emitter type="spot">
        <transform name="toWorld">
            <lookAt origin="0, 0, 0.1" target="2, 0, 1" up="0, 1, 0"/>
        </transform>
        <float name="cutoffAngle" value="10.0"/>
        <float name="beamWidth" value="10.0"/>
        <rgb name="intensity" value="100.0, 90.0, 40.0"/>
    </emitter> -->

    <emitter type="spot">
        <transform name="toWorld">
            <lookAt origin="0, 0, 0.1" target="0, 0, 1" up="0, 1, 0"/>
        </transform>
        <float name="cutoffAngle" value="89.0"/>
        <float name="beamWidth" value="89.0"/>
        <rgb name="intensity" value="100.0, 90.0, 40.0"/>
    </emitter>
	
	<!-- Add the geometry - floating quads -->
	<include filename="$geometry:hemisphere_n1980_ratio0.4949.xml"/>
	<!-- <include filename="../scene_geometries/quads-geometry.xml"/> -->
</scene>
